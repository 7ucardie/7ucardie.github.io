---
import '../styles/global.css';
import { SITE } from '../site.config.mjs';

interface Props {
  title: string;
  description: string;
  /** 'website' or 'article' for Open Graph. */
  type?: 'website' | 'article';
  image?: string;
  /** Extra JSON-LD objects to emit. */
  jsonLd?: Record<string, unknown>[];
}

const { title, description, type = 'website', image, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? SITE.ogImage, Astro.site).toString();
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#011425" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((obj) => <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700&family=IBM+Plex+Mono:wght@400;700&display=optional" rel="stylesheet" />
  </head>
  <body>
    <a href="#main" class="skip">Skip to main content</a>

    <header class="nav">
      <div class="nav-inner">
        <a href="/" class="nav-brand"><div class="nav-dot"></div>{SITE.name}</a>
        <nav class="nav-links" aria-label="Primary navigation">
          {SITE.nav.map((item) => (
            <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>{item.label}</a>
          ))}
        </nav>
        <div style="display:flex;align-items:center;gap:20px">
          {SITE.github && (
            <a href={SITE.github} class="nav-cta" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
              <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            </a>
          )}
          <button class="hamburger" id="burger" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobileDrawer"><span></span><span></span><span></span></button>
        </div>
      </div>
    </header>
    <div class="mobile-drawer" id="mobileDrawer">
      {SITE.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      {SITE.github && <a href={SITE.github} target="_blank" rel="noopener noreferrer">GITHUB</a>}
    </div>

    <main id="main">
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <div class="footer-inner">
          <div class="footer-left">
            &copy; {new Date().getFullYear()} <a href={SITE.author.url}>{SITE.author.name}</a>
          </div>
          <ul class="footer-links">
            {SITE.footerLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>
      </div>
    </footer>

    <script>
      const burger = document.getElementById('burger');
      const drawer = document.getElementById('mobileDrawer');
      burger?.addEventListener('click', () => {
        const open = drawer?.classList.toggle('open');
        burger.classList.toggle('open', !!open);
        burger.setAttribute('aria-expanded', String(!!open));
      });
      drawer?.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => {
          drawer.classList.remove('open');
          burger?.classList.remove('open');
          burger?.setAttribute('aria-expanded', 'false');
        }),
      );
    </script>
  </body>
</html>
